# Secrets for compose.yaml. Copy to .env and change every value:
#   cp .env.example .env
POSTGRES_PASSWORD=change_me
REPLICA_PASS=change_me
PCP_PASS=change_me

# --- Optional settings for the root scripts (BUILD.sh, EXPORT.sh, RUN.sh, RUN.dev.sh, CLEAN.sh) ---
# PGCLOUD_HUB=zhenglinlei            # Docker Hub namespace of the images
# PGCLOUD_VERSION=1.0.1              # default: version in tools/pgcloud-launcher/package.json
# LAUNCHER_PORT=8080                 # RUN.sh / RUN.dev.sh
# LAUNCHER_ADMIN_PASSWORD=           # RUN.sh: fixed admin password (empty = generated)
# LAUNCHER_CONTAINER=pgcloud-launcher
# LAUNCHER_VOLUME=pgcloud-launcher
