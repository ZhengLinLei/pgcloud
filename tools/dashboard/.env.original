# PGCloud Tools Monitor Virtual Configuration File
# =============================================

# Database connection settings
PG_DATABASE="postgres"
PG_USER="monitor_user"
PG_PASSWORD="your_password"

# Thresholds
WAL_SIZE_WARNING=80
WAL_SIZE_CRITICAL=95
REPLICATION_LAG_WARNING=60
REPLICATION_LAG_CRITICAL=300
CONNECTION_WARNING=80
CONNECTION_CRITICAL=95

# Nodes to monitor
NODES="localhost:5432,replica1:5432"

# Enable/disable checks
CHECK_WAL=true
CHECK_REPLICATION=true
CHECK_CONNECTIONS=true
CHECK_QUERY_PERFORMANCE=true
CHECK_DISK_USAGE=true