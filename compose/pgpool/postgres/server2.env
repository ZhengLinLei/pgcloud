# Postgres node 2 for the compose demo (see docker/pgpool/conf/postgres/server.sample.env)
PSQL_HOST=db2
PSQL_PORT=5432
PSQL_WEIGHT=1
PSQL_FAIL=ALLOW_TO_FAILOVER
PSQL_PATH=/opt/pgdata
PSQL_ACTIVE=true
PSQL_NAME=node2
# SSH is only used by automatic failover recovery on multi-host deployments
SSH_USER=
SSH_PORT=22
SSH_PASS=
